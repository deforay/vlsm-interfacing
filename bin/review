#!/usr/bin/env bash
#
# review — hand the change to a second reader before it is trusted.
#
# Usage:
#   bin/review                  the commits not yet recorded as reviewed
#   bin/review <a>..<b>         a range; recorded when it ends at HEAD
#   bin/review <commit-sha>     one commit, without recording it
#   bin/review --uncommitted    the working tree, before committing
#   bin/review --pending        list the commits not yet recorded as reviewed
#   bin/review --mark [sha]     record a commit (default HEAD) as reviewed
#   bin/review --help           this text
#
#   --verify may precede any review form, and REVIEW_VERIFY=1 in .env makes it
#   the default. It adds a second pass whose only job is to refute the first
#   one's findings.
#
# The ledger of reviewed commits is kept in the clone's git directory
# (.git/reviewed-commits.txt), never in a commit. Each line holds a commit, its
# patch-id, the time and the subject. git land rebase-merges, so a commit gets a
# new identity on master; the patch-id still matches, so it is not read twice.
#
# The reviewing CLI is named by $REVIEW_AGENT rather than written down here, so
# the repository carries no vendor name and the reader can be swapped without
# editing anything. It is a command line, so a reader that wants a subcommand
# and one that wants a flag are both a setting. Set it in the untracked .env.
#
# The brief is READ from review/brief.md rather than repeated here. Two
# copies of a review brief means the one nobody edits is the one that runs.
set -euo pipefail

cd "$(dirname "$0")/.."

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '3,29p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi

# Reads one key from the untracked .env, so the reader's name lives on the
# machine rather than in the repo. Only the REVIEW_ keys are read: a CLI that
# reads a diff has no business inheriting the database password or the signing
# certificate.
read_env() {
    [ -f .env ] || return 0
    awk -v key="$1" -F= '$0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
        sub(/^[^=]*=[[:space:]]*/, ""); gsub(/^["'\'']|["'\'']$/, ""); print; exit }' .env
}

# --git-common-dir rather than --git-dir: in a linked worktree the latter is
# .git/worktrees/<name>, which would give each worktree a ledger of its own.
LEDGER="${REVIEW_LEDGER:-$(read_env REVIEW_LEDGER)}"
[ -n "$LEDGER" ] || LEDGER="$(git rev-parse --git-common-dir)/reviewed-commits.txt"

# Where an empty ledger starts. Reading the whole history to bootstrap would be
# days of work nobody asked for. Anything older is deemed shipped.
BOOTSTRAP_COMMITS=10

patch_id() {
    git show --format= "$1" | git patch-id --stable | awk '{print $1}'
}

# True when the commit, or a commit with the same change, is in the ledger.
is_recorded() {
    [ -f "$LEDGER" ] || return 1
    local sha id
    sha="$(git rev-parse "$1")"
    grep -q "^$sha	" "$LEDGER" && return 0
    id="$(patch_id "$sha")"
    # An empty commit has no patch-id, and one empty commit is not another.
    [ -n "$id" ] && awk -F'\t' -v id="$id" '$2 == id {found=1} END {exit !found}' "$LEDGER"
}

# The newest commit on HEAD that the ledger names by its own identity. Read
# bottom-up, and only an ancestor of HEAD counts: an amend or a rebase leaves
# the recorded object behind, and `thatSha..HEAD` would not be a range of
# anything.
last_reviewed() {
    [ -f "$LEDGER" ] || return 0
    local sha
    while IFS=$'\t' read -r sha _; do
        case "$sha" in ''|\#*) continue ;; esac
        if git merge-base --is-ancestor "$sha" HEAD 2>/dev/null; then
            echo "$sha"
            return 0
        fi
    done < <(tail -r "$LEDGER" 2>/dev/null || tac "$LEDGER")
}

# The commits on HEAD that the ledger does not account for, oldest first.
pending_commits() {
    local base sha
    base="$(last_reviewed)"
    [ -n "$base" ] || base="$(git rev-parse "HEAD~$BOOTSTRAP_COMMITS" 2>/dev/null || true)"
    for sha in $(git rev-list --reverse "${base:+$base..}HEAD"); do
        is_recorded "$sha" || echo "$sha"
    done
}

mark_reviewed() {
    local sha
    sha="$(git rev-parse "${1:-HEAD}")"
    if is_recorded "$sha"; then
        echo "Already recorded: $(git log -1 --format='%h %s' "$sha")"
        return 0
    fi
    printf '%s\t%s\t%s\t%s\n' "$sha" "$(patch_id "$sha")" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        "$(git log -1 --format='%s' "$sha")" >> "$LEDGER"
    echo "Recorded as reviewed: $(git log -1 --format='%h %s' "$sha")"
}

# A second pass that only tries to refute the first one's findings. One pass
# that both finds and reports has nothing pushing back on it, and that is where
# false positives live. Refuting is a different job from finding: it is bounded
# by the number of findings rather than by the size of the diff. Off unless
# asked, because it doubles the cost of a run.
VERIFY="${REVIEW_VERIFY:-$(read_env REVIEW_VERIFY)}"
[ -n "$VERIFY" ] || VERIFY=0
if [ "${1:-}" = "--verify" ]; then
    VERIFY=1
    shift
fi

case "${1:-}" in
    --pending)
        PENDING="$(pending_commits)"
        if [ -z "$PENDING" ]; then
            echo "Nothing pending: every commit on HEAD is recorded as reviewed."
            exit 0
        fi
        echo "Not yet recorded as reviewed:"
        for sha in $PENDING; do git log -1 --format='  %h  %s' "$sha"; done
        exit 0
        ;;
    --mark)
        mark_reviewed "${2:-HEAD}"
        exit 0
        ;;
esac

REVIEW_AGENT="${REVIEW_AGENT:-$(read_env REVIEW_AGENT)}"
REVIEW_AGENT_STDIN="${REVIEW_AGENT_STDIN:-$(read_env REVIEW_AGENT_STDIN)}"
# A second reader for when the first is out of usage. Optional.
REVIEW_AGENT_FALLBACK="${REVIEW_AGENT_FALLBACK:-$(read_env REVIEW_AGENT_FALLBACK)}"
REVIEW_AGENT_FALLBACK_STDIN="${REVIEW_AGENT_FALLBACK_STDIN:-$(read_env REVIEW_AGENT_FALLBACK_STDIN)}"
REVIEW_LIMIT_PATTERN="${REVIEW_LIMIT_PATTERN:-$(read_env REVIEW_LIMIT_PATTERN)}"
[ -n "$REVIEW_LIMIT_PATTERN" ] || REVIEW_LIMIT_PATTERN='usage limit|rate limit|quota'

if [ -z "$REVIEW_AGENT" ]; then
    echo "REVIEW_AGENT is not set. It is the command line that performs the review." >&2
    echo "Set it in the untracked .env:   REVIEW_AGENT='<your-review-cli> <subcommand>'" >&2
    exit 1
fi

BRIEF_FILE="review/brief.md"
if [ ! -f "$BRIEF_FILE" ]; then
    echo "Missing $BRIEF_FILE: the standing brief the reader is given." >&2
    exit 1
fi
BRIEF="$(cat "$BRIEF_FILE")"

# The reader reads the repository itself, so it gets pointers rather than pasted
# files. Naming these is the difference between a review of this system and a
# review of some TypeScript: without them it cannot know that a value rounded on
# its way to the database, or a second copy of a frame reassembly, is a patient
# safety bug here rather than a matter of taste.
CONTEXT="Before reviewing, read these for the rules this codebase is held to:
- review/brief.md — the invariants, and what a finding must look like
- docs/technical/ — how the system is put together, the protocols as the analyzers
  actually speak them, and what is stored where
- src/app/services/analyzer-captures.spec.ts and src/app/testing/fixtures/captured/ —
  transmissions from real laboratories, replayed. These are the contract with the
  field: a change that alters what a real analyzer's message stores must fail here.
- src/app/testing/wire-harness.ts — bytes in, database rows out, with the real
  parsers. A defect that a harness test could catch and does not is itself a finding.
- app/sqlite-migrations/ — append-only; the versions table records what has run.
- scripts/check-electron-safety.mjs — why the renderer's Node integration is safe,
  and the two assumptions that keep it that way.

$BRIEF"

# The commits a finished review records. Resolved to concrete SHAs now, not
# after the reader returns: a review takes minutes, and HEAD can move under it.
# What is recorded afterwards is this list, whatever HEAD has become.
MARK_AFTER=""
range_scope() {
    echo "Review the changes introduced by these commits together: \`git diff $1\`, with
\`git log --reverse --format='%h %s' $1\` for what each one was for. Judge them as one body
of work: a defect introduced in one commit and fixed in a later one is not a finding.
Ignore code outside that diff except where you need it to judge the diff."
}

case "${1:-}" in
    --uncommitted)
        SCOPE="Review the staged, unstaged and untracked changes in the working tree (\`git status\`, \`git diff\`, \`git diff --cached\`)." ;;
    "")
        MARK_AFTER="$(pending_commits)"
        if [ -z "$MARK_AFTER" ]; then
            echo "Nothing to review: every commit on HEAD is recorded as reviewed."
            exit 0
        fi
        FIRST="$(echo "$MARK_AFTER" | head -n1)"
        RANGE="$(git rev-parse --short "$FIRST")^..$(git rev-parse --short HEAD)"
        echo "Reviewing $RANGE, $(echo "$MARK_AFTER" | wc -l | tr -d ' ') commit(s) not yet recorded:"
        for sha in $MARK_AFTER; do git log -1 --format='  %h  %s' "$sha"; done
        echo
        SCOPE="$(range_scope "$RANGE")"
        if [ "$(git rev-list --count "$RANGE")" != "$(echo "$MARK_AFTER" | wc -l | tr -d ' ')" ]; then
            SCOPE="$SCOPE
Some commits in that range were already reviewed under another identity. Read the
whole range, but these are the ones not yet read: $(for sha in $MARK_AFTER; do printf '%s ' "$(git rev-parse --short "$sha")"; done)"
        fi
        ;;
    *..*)
        RANGE="$1"
        END="${1##*..}"
        if [ "$(git rev-parse "$END")" = "$(git rev-parse HEAD)" ]; then
            MARK_AFTER="$(git rev-list --reverse "$RANGE")"
        fi
        echo "Reviewing $RANGE, $(git rev-list --count "$RANGE") commit(s):"
        git log --reverse --format='  %h  %s' "$RANGE"
        echo
        SCOPE="$(range_scope "$RANGE")" ;;
    *)
        SCOPE="Review the changes introduced by commit $1: \`git show $1\`. Ignore code outside that diff except where you need it to judge the diff." ;;
esac

PROMPT="$SCOPE

$CONTEXT"

# Scratch files for this run, removed however it ends. Spelled out rather than
# `mktemp -t`, whose meaning differs between BSD and GNU.
SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/review.XXXXXX")"
trap 'rm -rf "$SCRATCH"' EXIT

# One run of one reader. Output streams to the terminal, and copies go to $4
# (both streams, to recognise a refusal for lack of usage) and $4.out (stdout
# alone: the findings). fd 3 carries stdout past the pipe that copies stderr.
# Word-splitting the command line is intended.
# shellcheck disable=SC2086
attempt() {
    local agent="$1" stdin="$2" prompt="$3" log="$4"
    if [ "$stdin" = "1" ]; then
        { { printf '%s' "$prompt" | $agent | tee -a "$log" "$log.out"; } 2>&1 1>&3 | tee -a "$log" >&2; } 3>&1
    else
        { { $agent "$prompt" | tee -a "$log" "$log.out"; } 2>&1 1>&3 | tee -a "$log" >&2; } 3>&1
    fi
}

# Runs one pass and leaves its findings in $SCRATCH/findings. When the reader
# stops because it is out of usage (a non-zero exit AND a message matching
# REVIEW_LIMIT_PATTERN, so a finding that mentions a limit cannot trigger it),
# the same prompt goes to REVIEW_AGENT_FALLBACK, which then handles the rest of
# the run, verify pass included.
run_reader() {
    local log="$SCRATCH/run.$RANDOM" status=0
    if [ -f "$SCRATCH/fallback" ]; then
        attempt "$REVIEW_AGENT_FALLBACK" "$REVIEW_AGENT_FALLBACK_STDIN" "$1" "$log" || status=$?
    else
        attempt "$REVIEW_AGENT" "$REVIEW_AGENT_STDIN" "$1" "$log" || status=$?
        if [ "$status" -ne 0 ] && [ -n "$REVIEW_AGENT_FALLBACK" ] && grep -qiE "$REVIEW_LIMIT_PATTERN" "$log"; then
            echo >&2
            echo "── the reader is out of usage: continuing with REVIEW_AGENT_FALLBACK ──" >&2
            echo >&2
            : > "$SCRATCH/fallback"
            log="$log.fallback"
            status=0
            attempt "$REVIEW_AGENT_FALLBACK" "$REVIEW_AGENT_FALLBACK_STDIN" "$1" "$log" || status=$?
        fi
    fi
    # A review always says something. A reader that exits cleanly with nothing
    # on stdout was stopped before it could review (some exit 0 after refusing
    # a command they needed), so nothing was reviewed.
    if [ "$status" -eq 0 ] && [ ! -s "$log.out" ]; then
        echo "The reader exited without printing a review, so nothing was reviewed." >&2
        status=1
    fi
    [ "$status" -ne 0 ] || cp "$log.out" "$SCRATCH/findings"
    return "$status"
}

# A failed pass stops the script (set -e), so an abandoned or refused review
# never reaches the ledger.
run_reader "$PROMPT"

if [ "$VERIFY" = "1" ]; then
    echo
    echo "── verifying ──────────────────────────────────────────────────────────────"
    echo

    # Deliberately one-sided. This pass is not asked whether the findings are
    # good, it is asked to break them: a reader invited to "check" a claim
    # mostly agrees with it. Its own evidence is held to the same bar the brief
    # sets for a finding.
    VERIFY_PROMPT="A review pass on this repository produced the findings below. Your only
job is to try to REFUTE each one. Do not add findings of your own, do not restate them, and do
not soften them into suggestions.

For each finding, open the code it cites and answer with one of:
  CONFIRMED   file:line and the quoted line that proves the defect is real
  REFUTED     file:line and the quoted line that shows the claim is wrong, or that names the
              premise it rests on and shows that premise is false
  UNVERIFIED  you could not find the line either way; say what you looked for

A finding whose premise is a claim about code is refuted the moment that code says otherwise,
however plausible the reasoning built on it. A deliberate trade-off recorded in the commit
message, in a comment, or in review/brief.md is refuted too: it is a rebuttal, not a defect.

Finish with the surviving findings only, in severity order, each with its evidence. Say
plainly how many you refuted and why. If every finding is refuted, say that.

$SCOPE

The findings to refute:

$(cat "$SCRATCH/findings")"

    run_reader "$VERIFY_PROMPT"
fi

if [ -n "$MARK_AFTER" ]; then
    echo
    for sha in $MARK_AFTER; do
        mark_reviewed "$sha"
    done
    echo "Ledger updated: $LEDGER"
fi
